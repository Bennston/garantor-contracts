{
    "compilerOptions": {
        "target": "ES2020",
        "outDir": "dist",
        "module": "commonjs",
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "contracts/**/*.ts",
        "tests/**/*.ts",
        "wrappers/**/*.ts",
        "build/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
